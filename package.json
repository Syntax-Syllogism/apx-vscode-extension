{
  "name": "apx-ext",
  "displayName": "Apx",
  "description": "Guided Apex generation and dead-code analysis powered by apx-core.",
  "version": "0.2.0",
  "publisher": "syntax-syllogism",
  "author": "Jake Richter <j.p.richter@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntax-Syllogism/apx-code-ext.git"
  },
  "bugs": {
    "url": "https://github.com/Syntax-Syllogism/apx-code-ext/issues"
  },
  "homepage": "https://github.com/Syntax-Syllogism/apx-code-ext#readme",
  "icon": "media/apx-logo.png",
  "keywords": [
    "salesforce",
    "sf",
    "sfdx",
    "apx",
    "apex enterprise patterns"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:sfdx-project.json",
    "workspaceContains:**/.sf/config.json",
    "onView:apxCommands"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apx.generate",
        "title": "SF Apx: Generate (Multiple)"
      },
      {
        "command": "apx.generate.selector",
        "title": "SF Apx: Generate Selector"
      },
      {
        "command": "apx.generate.domain",
        "title": "SF Apx: Generate Domain"
      },
      {
        "command": "apx.generate.service",
        "title": "SF Apx: Generate Service"
      },
      {
        "command": "apx.generate.unitofwork",
        "title": "SF Apx: Generate Unit of Work"
      },
      {
        "command": "apx.generate.selector.method",
        "title": "SF Apx: Selector Method"
      },
      {
        "command": "apx.generate.selector.field-injection",
        "title": "SF Apx: Selector Field Injection"
      },
      {
        "command": "apx.generate.action",
        "title": "SF Apx: Generate Action"
      },
      {
        "command": "apx.generate.criteria",
        "title": "SF Apx: Generate Criteria"
      },
      {
        "command": "apx.dead",
        "title": "SF Apx: Find Dead Code"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apx",
          "title": "Apx",
          "icon": "media/apx.svg"
        }
      ]
    },
    "views": {
      "apx": [
        {
          "id": "apxCommands",
          "name": "Commands"
        }
      ]
    },
    "configuration": {
      "title": "Apx",
      "properties": {
        "apx.defaultTargetOrg": {
          "type": "string",
          "default": "",
          "description": "Default Salesforce org alias or username for Apx commands."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm run package && vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "prepare": "husky",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "test": "vscode-test",
    "sync:contributes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-contributes.mjs"
  },
  "lint-staged": {
    "*.md": "markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@salesforce/core": "^8",
    "@syntax-syllogism/apx-core": "0.3.1",
    "zod": "^4"
  }
}
