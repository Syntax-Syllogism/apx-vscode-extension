          "char": "s",
          "name": "sobject",
          "required": true,
          "summary": "SObject API name used for generated artifacts.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "class-name": {
          "char": "c",
          "name": "class-name",
          "required": true,
          "summary": "Selector method-injection class name.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "trigger-operation": {
          "name": "trigger-operation",
          "summary": "Trigger operation enum value for AT4DX domain-process bindings.",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "Before_Insert",
            "Before_Update",
            "Before_Delete",
            "After_Insert",
            "After_Update",
