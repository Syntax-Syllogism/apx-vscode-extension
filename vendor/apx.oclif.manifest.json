{
  "commands": {
    "apx:generate": {
      "aliases": [],
      "args": {},
      "description": "Builds selector/domain/unit-of-work plans from one SObject describe and writes all selected outputs in a single manifest.",
      "examples": [
        "Generate selector, domain, and unit-of-work in AT4DX style:\n<%= config.bin %> <%= command.id %> --target-org myOrg --sobject Account --selector --domain --unit-of-work --at4dx"
      ],
      "flags": {
        "json": {
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "flags-dir": {
          "helpGroup": "GLOBAL",
          "name": "flags-dir",
          "summary": "Import flag values from a directory.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "target-org": {
          "char": "o",
          "name": "target-org",
          "noCacheDefault": true,
          "required": true,
          "summary": "Target org username or alias.",
          "hasDynamicHelp": true,
          "multiple": false,
          "type": "option"
        },
        "sobject": {
          "char": "s",
          "name": "sobject",
          "required": true,
          "summary": "SObject API name used for generated artifacts.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "at4dx": {
          "name": "at4dx",
          "summary": "Generate AT4DX-flavor artifacts.",
          "allowNo": false,
          "type": "boolean"
        },
        "fflib": {
          "name": "fflib",
          "summary": "Generate fflib-flavor artifacts.",
          "allowNo": false,
          "type": "boolean"
        },
        "api-version": {
          "char": "a",
          "description": "Override the api version used for api requests made by this command",
          "name": "api-version",
          "summary": "Override the API version used for the org connection.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "binding-sequence": {
          "char": "b",
          "name": "binding-sequence",
          "summary": "Binding sequence value for AT4DX unit-of-work metadata.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "output-path": {
          "char": "p",
          "name": "output-path",
          "summary": "Output folder relative to the Salesforce project root.",
          "default": "generated-files",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "prefix": {
          "name": "prefix",
          "summary": "Optional namespace-style class prefix.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "selector": {
          "char": "r",
          "name": "selector",
          "summary": "Include selector artifacts in aggregate generation.",
          "allowNo": false,
          "type": "boolean"
        },
        "domain": {
          "char": "d",
          "name": "domain",
          "summary": "Include domain artifacts in aggregate generation.",
          "allowNo": false,
          "type": "boolean"
        },
        "unit-of-work": {
          "char": "u",
          "name": "unit-of-work",
          "summary": "Include unit-of-work artifacts in aggregate generation.",
          "allowNo": false,
          "type": "boolean"
        },
        "dry-run": {
          "name": "dry-run",
          "summary": "Render and validate generation output without writing files.",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "hasDynamicHelp": true,
      "hiddenAliases": [],
      "id": "apx:generate",
      "pluginAlias": "@syntax-syllogism/apx",
      "pluginName": "@syntax-syllogism/apx",
      "pluginType": "core",
      "strict": true,
      "summary": "Generate multiple AEP artifact groups in one command run.",
      "enableJsonFlag": true,
      "isESM": true,
      "relativePath": [
        "lib",
        "commands",
        "apx",
        "generate.js"
      ],
      "aliasPermutations": [],
      "permutations": [
        "apx:generate",
        "generate:apx"
      ]
    },
    "apx:generate:action": {
      "aliases": [],
      "args": {},
      "description": "Creates offline action scaffolding and a DomainProcessBinding record without requiring an org connection.",
      "examples": [
        "Generate action artifacts with defaults:\n<%= config.bin %> <%= command.id %> -s Account -c DefaultAccountSloganBasedOnNameAction"
      ],
      "flags": {
        "json": {
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "allowNo": false,
