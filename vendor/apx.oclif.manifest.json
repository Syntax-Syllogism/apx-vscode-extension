          ],
          "type": "option"
        },
        "order": {
          "name": "order",
          "summary": "Order-of-execution token used for AT4DX domain-process bindings (for example, 10.1).",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "process-name": {
          "name": "process-name",
          "summary": "Optional process token used to build AT4DX binding developer names.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
