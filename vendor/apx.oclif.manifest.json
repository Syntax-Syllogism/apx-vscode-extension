          "summary": "Override the API version used for the org connection.",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "output-path": {
          "char": "p",
          "name": "output-path",
          "summary": "Output folder relative to the Salesforce project root.",
          "default": "generated-files",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "dry-run": {
          "name": "dry-run",
          "summary": "Render and validate generation output without writing files.",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "apx:generate:action",
      "pluginAlias": "@syntax-syllogism/apx",
      "pluginName": "@syntax-syllogism/apx",
      "pluginType": "core",
      "strict": true,
      "summary": "Generate an AT4DX domain-process action class, test, and binding metadata.",
      "enableJsonFlag": true,
      "isESM": true,
      "relativePath": [
